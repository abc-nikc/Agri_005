# Server
NODE_ENV=development
PORT=3000

# Database (MySQL)
DATABASE_URL=mysql://root:password@localhost:3306/farm_management
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=farm_management

# InfluxDB
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your-influx-token-here
INFLUX_ORG=your-org
INFLUX_BUCKET=farm_management

# MQTT
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=guest
MQTT_PASSWORD=guest

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=2h
REFRESH_TOKEN_SECRET=your-super-secret-refresh-key-change-in-production
REFRESH_TOKEN_EXPIRY=7d

# Redis (optional)
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
