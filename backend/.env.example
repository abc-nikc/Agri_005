# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=farm_management
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_CONNECTION_LIMIT=10

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRY=2h
REFRESH_TOKEN_SECRET=your_refresh_secret_key_here
REFRESH_TOKEN_EXPIRY=7d

# Redis (optional, fallback to memory)
REDIS_URL=redis://localhost:6379

# InfluxDB (optional)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your_token
INFLUX_ORG=farm-org
INFLUX_BUCKET=farm_management

# MQTT
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Notification channels: in_app,email,wechat,mqtt
NOTIFICATION_CHANNELS=in_app

# Email notification (enable by adding email to NOTIFICATION_CHANNELS)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Enterprise WeChat bot (enable by adding wechat to NOTIFICATION_CHANNELS)
WECHAT_WEBHOOK_URL=

# AI (Zhipu GLM-4-Flash)
ZHIPU_API_KEY=your_api_key_here

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
