    "echarts": "^5.4.3",
    "element-plus": "^2.5.5",
    "jspdf": "^2.5.1",
    "leaflet": "^1.9.4",
    "pinia": "^2.1.7",
    "qrcode.vue": "^3.4.1",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/leaflet": "^1.9.21",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vue/test-utils": "^2.4.4",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.1",
    "jsdom": "^23.2.0",
    "prettier": "^3.1.1",
